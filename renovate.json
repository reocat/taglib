{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "ignoreTests": true,
  "ignoreUnstable": false,
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
